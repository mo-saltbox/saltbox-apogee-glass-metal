" id="contentRegion" role="presentation" cellspacing="0" cellpadding="0" locked="0">                                       <tr>                     <td align="Center"><img style="width: 100%; display: block; border: none; max-width: 100%; object-fit: fill;" src="https://apog.my.salesforce.com/projRes/ui-template-builder-components/images/Image_Placeholder.jpg" alt="" width="600" /></td>                    </tr>                                     </table></td>                </tr>                             </table></td>            </tr>                     </table>          <table class="contentbuilderBaseColumnRow" style="align-items: flex-start; width: 100%; background-color:;" role="presentation" width="100%" cellpadding="0" cellspacing="0">                       <tr valign="top">             <td width="100%" class="columnCell" style="vertical-align: top;display: inline-block; float:left">              <table cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse; word-break:break-word;">                               <tr>                 <td>                  <table style="width: 100%; border-collapse: collapse; word-break: break-word; font-size: 14px" id="contentRegion" role="presentation" cellspacing="0" cellpadding="0" locked="0">                                       <tr>                     <td style="font-family: Arial, Helvetica, sans-serif;padding-top: 30px;padding-right: 10px;padding-bottom: 30px;padding-left: 20px;"><span style="line-height:1.5;"><b><span style="font-size:11.0pt"><span style="font-family:&quot;Aptos&quot;,sans-serif"><a href="https://www.viracon.com/security/" style="color:#467886; text-decoration:underline"><span style="color:#005eb8;">Viracon’s security glass portfolio</span></a></span></span></b><span style="font-size:11.0pt"><span style="font-family:&quot;Aptos&quot;,sans-serif"> features a range of laminated glass products engineered to help deter forced-entry threats while supporting modern design goals. Tested to meet the rigorous <a href="https://store.astm.org/f3561-22.html" style="color:#467886; text-decoration:underline"><span style="color:#005eb8;">ASTM F3561 standard test method</span></a> for security glazing performance, our laminated glass solutions offer enhanced protection for building occupants without sacrificing natural daylighting or aesthetic appeal. As security concerns grow, trust Viracon’s proven expertise to deliver high-performance laminated glass that meets today’s evolving safety and design requirements.</span></span></span></td>                    </tr>                                     </table></td>                </tr>                             </table></td>            </tr>                     </table>          <table class="contentbuilderBaseColumnRow" style="align-items: flex-start; width: 100%; background-color:;" role="presentation" width="100%" cellpadding="0" cellspacing="0">                       <tr valign="top">             <td width="100%" class="columnCell" style="vertical-align: top;display: inline-block; float:left">              <table cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse; word-break:break-word;">                               <tr>                 <td>                  <table style="width: 100%; border-collapse: collapse; word-break: break-word; font-size: 14px" id="contentRegion" role="presentation" cellspacing="0" cellpadding="0" locked="0">                                       <tr>                     <td style="font-family: Arial, Helvetica, sans-serif;"><h6 style="color: rgb(17, 17, 17); font-family: Arial; font-size: 18px; font-weight: bold; margin: 0px; text-align: center;"><span style="color:#005eb8;">Interlayers matter when selecting security glass</span></h6></td>                    </tr>                                     </table></td>                </tr>                             </table></td>            </tr>                     </table>          <table class="contentbuilderBaseColumnRow" style="align-items: flex-start; width: 100%; background-color:;" role="presentation" width="100%" cellpadding="0" cellspacing="0">                       <tr valign="top">             <td width="50%" class="columnCell" style="vertical-align: top;display: inline-block; float:left">              <div class="columnDiv" style="margin-right: 5px;margin-bottom: 5px;">               <table cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse; word-break:break-word;">                                 <tr>                  <td>                   <table style="width:100%; border-collapse: collapse; word-break:break-word;" id="contentRegion" role="presentation" cellspacing="0" cellpadding="0" locked="0">                                         <tr>                      <td align="Center"><img style="width: 100%; display: block; border: none; max-width: 100%; object-fit: fill;" src="https://apog.my.salesforce.com/projRes/ui-template-builder-components/images/Image_Placeholder.jpg" alt="" width="295" /></td>                     </tr>                                       </table></td>                 </tr>                               </table>              </div></td>             <td width="50%" class="columnCell" style="vertical-align: top;display: inline-block; float:left">              <div class="columnDiv" style="margin-right: 5px;margin-bottom: 5px;">               <table cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse; word-break:break-word;">                                 <tr>                  <td>                   <table style="width: 100%; border-collapse: collapse; word-break: break-word; font-size: 14px" id="contentRegion" role="presentation" cellspacing="0" cellpadding="0" locked="0">                                         <tr>                      <td style="font-family: Arial, Helvetica, sans-serif;padding-right: 10px;"><span style="font-size:11pt"><span style="line-height:107%"><